# Copia este archivo como .env.local y llena los valores de tu proyecto de
# Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon

# Recordatorios (fase 4). Solo en el servidor: nunca con NEXT_PUBLIC_ salvo
# la clave pública de notificaciones.
# Clave service_role de Supabase: la usa el programador de recordatorios para
# revisar los pendientes de todos los usuarios.
SUPABASE_SERVICE_ROLE_KEY=
# Claves de notificaciones (VAPID). Se generan con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secreto que manda GitHub Actions al llamar /api/recordatorios.
CRON_SECRET=
# Correo con Resend (opcional). Sin dominio propio, Resend solo entrega al
# correo con el que se creó la cuenta.
RESEND_API_KEY=
RESEND_FROM=Agenda Universitaria <onboarding@resend.dev>
